{
    "name": "ernestdefoe/gatehouse",
    "description": "Approve new members before they get in: sign-ups from addresses you trust activate as normal, everyone else waits in a queue for an admin to approve or decline.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "registration",
        "approval",
        "moderation",
        "spam"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/gatehouse",
    "support": {
        "forum": "https://discuss.flarum.org/d/39995-gatehouse",
        "issues": "https://github.com/ernestdefoe/gatehouse/issues",
        "source": "https://github.com/ernestdefoe/gatehouse"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Gatehouse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Gatehouse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Gatehouse",
            "category": "moderation",
            "icon": {
                "name": "fas fa-dungeon",
                "backgroundColor": "#7c4a1e",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
